# Required for live Relay responses and live HTTP/MCP capability calls.
# Create your own .env from this file; never commit .env.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Optional. Defaults to gpt-5 when omitted.
# OPENAI_MODEL=gpt-5

# Optional for custom HTTP tools that need a secret header. List only the environment
# variable names that an administrator is allowed to reference in the UI.
# RELAY_TOOL_HEADER_ENV_ALLOWLIST=RESEARCH_API_KEY
# RESEARCH_API_KEY=replace_with_your_tool_key

# Optional for an HTTPS deployment. Leave unset for local http://localhost:8000.
# RELAY_COOKIE_SECURE=true
