{
  "version": "2.0.0",
  "title": "Shared Team AI Agent — Shared Context API",
  "assumptions": [
    "Northstar Consulting has three seeded members: John, Mary, and Bob. John is the only administrator; Mary and Bob are regular members.",
    "Canonical shared-context fixture data lives in app/data/data.json and is loaded into SQLite (team_memory.db) on first startup when shared_context_records is empty.",
    "Shared team context uses a single SharedContextRecord model with type chat or artifact. Tasks, decisions, blockers, and work status are inferred by the agent at retrieval time, not stored as separate entities or status fields.",
    "The browser must treat the server's explicit capability flag as authoritative for admin-panel visibility.",
    "Agent configuration is team-scoped, stored in SQLite, and applied on every chat completion."
  ],
  "resources": {
    "User": {"id": "string", "team_id": "string", "name": "John|Mary|Bob", "email": "string", "role": "admin|member"},
    "AuthenticatedUser": {"user": "User", "team": {"id": "string", "name": "string"}, "capabilities": {"admin_configuration": "boolean"}},
    "SharedContextRecord": {
      "id": "string",
      "type": "chat|artifact",
      "content": "string",
      "source_user_id": "string|null",
      "source_user_name": "string|null",
      "artifact_type": "documentation|handoff|conflict|string|null",
      "source_record_ids": "string[]",
      "created_at": "ISO-8601"
    },
    "ActivityEvent": {
      "id": "string",
      "team_id": "string",
      "record_id": "string",
      "action": "string",
      "summary": "string",
      "occurred_at": "ISO-8601"
    },
    "AgentConfiguration": {"team_id": "string", "system_prompt": "string", "updated_at": "ISO-8601", "updated_by": "User"},
    "AgentConfigurationEntry": {"id": "string", "team_id": "string", "kind": "tool|mcp_server|skill|markdown|prompt_template", "name": "string", "description": "string", "content": "string", "enabled": "boolean", "created_at": "ISO-8601", "updated_at": "ISO-8601"},
    "MessagePage": {"messages": "Message[] in ascending display order", "next_before": "opaque cursor|null", "has_more": "boolean"}
  },
  "authorization": {
    "session": "Every API endpoint except login and health requires an unexpired session cookie.",
    "admin_configuration": "Admin configuration routes require role admin. A non-admin receives 403.",
    "regular_member_visibility": "Regular members do not receive the admin configuration payload. Configuration is server-applied to their LLM completion requests."
  },
  "endpoints": [
    {"method": "POST", "path": "/api/auth/login", "auth": "public", "request": {"email": "string", "password": "string"}, "success": {"200": "AuthenticatedUser"}, "errors": ["401"]},
    {"method": "GET", "path": "/api/auth/me", "auth": "session", "success": {"200": "AuthenticatedUser"}, "errors": ["401"]},
    {"method": "GET", "path": "/api/bootstrap", "auth": "session", "success": {"200": {"team": "Team", "users": "User[]", "conversations": "Conversation[]", "active_user_id": "string", "capabilities": {"admin_configuration": "boolean"}}}, "errors": ["401"]},
    {"method": "GET", "path": "/api/context", "auth": "session", "params": {"q": "optional search string", "type": "optional chat|artifact", "artifact_type": "optional string e.g. conflict"}, "success": {"200": {"records": "SharedContextRecord[]"}}, "errors": ["401"]},
    {"method": "POST", "path": "/api/context", "auth": "session", "request": {"type": "chat|artifact", "content": "string, 1-24000 characters", "artifact_type": "optional string; only for artifact records", "source_record_ids": "optional string[]"}, "success": {"201": {"record": "SharedContextRecord", "event": "ActivityEvent"}}, "errors": ["400", "401"]},
    {"method": "GET", "path": "/api/context/{record_id}", "auth": "session", "success": {"200": {"record": "SharedContextRecord"}}, "errors": ["401", "404"]},
    {"method": "POST", "path": "/api/sessions", "auth": "session", "success": {"200": {"previous_last_seen_at": "ISO-8601|null", "events": "ActivityEvent[]", "records": "SharedContextRecord[]", "server_time": "ISO-8601"}}, "errors": ["401"]},
    {"method": "GET", "path": "/api/activity", "auth": "session", "params": {"since": "optional ISO-8601 timestamp"}, "success": {"200": {"events": "ActivityEvent[]", "server_time": "ISO-8601"}}, "errors": ["400", "401"]},
    {"method": "GET", "path": "/api/admin/configuration", "auth": "admin session", "success": {"200": {"configuration": "AgentConfiguration", "entries": "AgentConfigurationEntry[]"}}, "errors": ["401", "403"]},
    {"method": "PUT", "path": "/api/admin/configuration", "auth": "admin session", "request": {"system_prompt": "string, 1-12000 characters"}, "success": {"200": {"configuration": "AgentConfiguration"}}, "errors": ["400", "401", "403"]},
    {"method": "POST", "path": "/api/admin/configuration/entries", "auth": "admin session", "request": {"kind": "tool|mcp_server|skill|markdown|prompt_template", "name": "string", "description": "string", "content": "string", "enabled": "boolean"}, "success": {"201": {"entry": "AgentConfigurationEntry"}}, "errors": ["400", "401", "403"]},
    {"method": "PATCH", "path": "/api/admin/configuration/entries/{entry_id}", "auth": "admin session", "success": {"200": {"entry": "AgentConfigurationEntry"}}, "errors": ["400", "401", "403", "404"]},
    {"method": "DELETE", "path": "/api/admin/configuration/entries/{entry_id}", "auth": "admin session", "success": {"204": null}, "errors": ["401", "403", "404"]},
    {"method": "GET", "path": "/api/conversations/{conversation_id}/messages", "auth": "session and owner-only conversation", "params": {"limit": "optional integer 1-100; default 50", "before": "optional opaque cursor"}, "success": {"200": "MessagePage"}, "errors": ["400", "401", "404"]},
    {"method": "POST", "path": "/api/conversations/{conversation_id}/messages", "auth": "session and owner-only conversation", "request": {"content": "string"}, "success": {"201": {"user_message": "Message", "assistant_message": "Message", "matches": "SharedContextRecord[]", "related_records": "SharedContextRecord[]", "duplicate_resolution": {"detected": "boolean", "record_ids": "string[]", "recommended_next_step": "string|null"}, "share_suggestion": "object|null"}}, "errors": ["401", "404"]}
  ],
  "behavior": {
    "shared_context_model": "All team memory is stored as SharedContextRecord rows in SQLite. Fixture data is seeded from app/data/data.json. Records are immutable after creation; updates are expressed by adding new records.",
    "semantic_inference": "The agent infers tasks, blockers, decisions, and work status from record content at retrieval time. artifact_type may label documentation, handoff, or conflict artifacts.",
    "conflict_handling": "Conflicts are represented as artifact records with artifact_type=conflict and source_record_ids pointing to the disagreeing chat records.",
    "retrieval": "Message completion performs keyword/synonym search over record content and injects matched records into the LLM prompt.",
    "configuration_propagation": "Team agent configuration is loaded fresh from SQLite for every completion.",
    "long_conversation_loading": "Messages are paginated newest-first with opaque keyset cursors."
  }
}
